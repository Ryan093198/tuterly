      "sections": [
        "4A"
      ],
      "rule": "A surd is a root that isn't a whole number, like \\(\\sqrt2\\). Simplify using square factors.",
      "lines": [
        "\\(\\sqrt8 = 2\\sqrt2\\) &nbsp; \\(\\sqrt{48} = \\sqrt{16}\\sqrt3 = 4\\sqrt3\\)"
      ]
    },
    {
      "title": "Operations with surds",
      "sections": [
        "4B",
        "4C"
      ],
      "rule": "Add and subtract like surds only. Multiply or divide the numbers outside and inside separately.",
      "lines": [
        "\\(\\sqrt{12} + \\sqrt{27} = 2\\sqrt3 + 3\\sqrt3 = 5\\sqrt3\\)",
        "\\(\\sqrt6 \\times \\sqrt3 = \\sqrt{18} = 3\\sqrt2\\) &nbsp; \\(6\\sqrt{10} \\div 2\\sqrt5 = 3\\sqrt2\\)"
      ]
    },
    {
      "title": "Rationalising the denominator",
      "sections": [
        "4D"
      ],
      "rule": "Multiply top and bottom so there's no surd on the bottom.",
      "lines": [
        "\\(\\dfrac{3}{\\sqrt2} = \\dfrac{3\\sqrt2}{2}\\)",
        "\\(\\dfrac{1}{\\sqrt3 + 1} \\times \\dfrac{\\sqrt3 - 1}{\\sqrt3 - 1} = \\dfrac{\\sqrt3 - 1}{2}\\)"
      ]
    },
